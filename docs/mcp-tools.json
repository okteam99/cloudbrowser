{
  "tools": [
    {
      "name": "get_logs",
      "description": "Query durable, bounded, redacted service/browser/page/operation/recorder/tunnel events. Survives instance closure and manager restart when the data volume is preserved. Only this principal and generic service events are visible. No raw console text, credentials, request bodies or arbitrary file paths. Omit after_seq for recent events; use returned next_after_seq to read newer events.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "component": {
            "type": "string",
            "enum": [
              "service",
              "browser",
              "page",
              "operation",
              "recorder",
              "tunnel"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "after_seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 100
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "inspect_instance",
      "description": "Inspect a live, busy, crashed or retained historical instance without taking its action lock. Returns exit/close reason, current operation and elapsed time, frame/encoder health, resource metrics and recent warnings. Optional bounded renderer probe does not cancel or retry actions. A timeout or SIGKILL alone does not prove OOM.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "probe": {
            "type": "boolean",
            "default": true
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 5000,
            "default": 1500
          }
        },
        "required": [
          "instance_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
