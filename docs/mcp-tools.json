    {
      "name": "list_proxies",
      "description": "List platform proxies with proxy_id, name, declared country, protocol, server, health status, latest check time/latency/error and authentication flag; no credentials. Checks run every 5 minutes by default. Use status=healthy for recent successful checks; a probe does not guarantee target-site access or country. Defaults to enabled only. Use proxy_id in create_instance, check_proxy or proxy_curl.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "socks5",
              "http",
              "https"
            ]
          },
          "enabled_only": {
            "type": "boolean",
            "default": true
          },
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "unhealthy",
              "unknown",
              "checking",
              "disabled"
            ]
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
