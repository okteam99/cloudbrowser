    {
      "name": "proxy_curl",
      "description": "Send one HTTP(S) request through a saved enabled proxy_id using curl, without a browser or shell. Supports methods, headers, UTF-8 body, bounded response and optional redirects. Returns HTTP status, response headers/body and elapsed time, including 4xx/5xx. No direct fallback; private destinations remain blocked unless enabled by the operator. No automatic retry; writes may succeed even when a timeout is returned. Output can contain destination secrets: handle appropriately.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proxy_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ],
            "default": "GET"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            },
            "propertyNames": {
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            },
            "default": {}
          },
          "body": {
            "type": "string",
            "maxLength": 65536
          },
          "follow_redirects": {
            "type": "boolean",
            "default": false
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000,
            "default": 15000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 65536
          },
          "response_encoding": {
            "type": "string",
            "enum": [
              "text",
              "base64"
            ],
            "default": "text"
          }
        },
        "required": [
          "proxy_id",
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
